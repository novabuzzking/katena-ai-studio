# ─── Katena AI Studio — configuration ───────────────────────────────────────
# Copy to .env and fill in. Every section works in "demo/simulated" mode until
# its keys are added, so the system can run before credentials arrive.

# 1) CLAUDE — writes the posts from crew photos (required for live captions)
#    Get a key: https://platform.claude.com → API Keys
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-4-8
CLAUDE_MODEL=

# 2) LINKEDIN — publishes to the Katena company page
#    Needs a LinkedIn Developer app associated with the company page, verified
#    by a Page admin, plus approved Community Management API access for the
#    w_organization_social scope (a LinkedIn review — may be declined).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# 3) META — Instagram Business + Facebook Page, both via the Graph API.
#    The Meta app is created and authorized against the Page and IG account.
#    Account ids and tokens are kept out of this repo — see the private
#    deployment notes for the real values.
IG_USER_ID=
FB_PAGE_ID=
# User token from the Graph API Explorer (app: Katena AI Studio). Short-lived
# (~1h) unless exchanged for a long-lived one — see README "Going live".
META_ACCESS_TOKEN=
# Page token for publishing to the Facebook Page. Get it from
# GET /me/accounts on the token above; falls back to META_ACCESS_TOKEN.
FB_PAGE_ACCESS_TOKEN=
# Instagram and Facebook both fetch the image from a public URL, so the studio
# must be reachable from the internet when publishing (e.g. https://studio.katena.ca).
PUBLIC_BASE_URL=

# 4) ACCESS CONTROL — REQUIRED before the studio is reachable from the internet.
#    The dashboard's approve/publish endpoints have no other protection, so an
#    exposed studio without this lets anyone post as Katena. When set, every
#    route except /uploads asks for it via HTTP Basic auth (any username).
#    Leave blank ONLY for localhost-only use.
#    Generate one with:  openssl rand -hex 16
STUDIO_SECRET=

# 5) POSTING SCHEDULE (defaults: Mon/Wed/Fri at 10:00 local server time)
PORT=8787
